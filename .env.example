# Safe, non-secret instance presentation/capability configuration.
# These may be exposed to the browser through the public instance capability payload.
HEALTH_APP_NAME=Health
HEALTH_EXTERNAL_HOME_URL=
HEALTH_PUBLIC_DEMO_ENABLED=true
# Photo import also requires both HOME_AI_BASE_URL and HOME_AI_API_KEY.
HEALTH_FEATURE_TRAINING_PHOTO_IMPORT=true

# Server-only PostgreSQL connection string.
# Never prefix this with VITE_. Never expose it to client code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Server-only Home AI (home-ai) transcription. Never prefix these with VITE_.
# Set the deployment-specific Home-AI URL only when this instance uses Home-AI.
HOME_AI_BASE_URL=
HOME_AI_API_KEY=

# Managed Better Auth (Neon Auth). Server-only base URL from the Neon Console
# Auth Configuration tab. Never prefix NEON_AUTH_COOKIE_SECRET or owner IDs with VITE_.
# Generate the cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=

# Preferred: Neon Auth user id from neon_auth.user.id after the one-time owner signup.
HEALTH_OWNER_USER_ID=
# Bootstrap only: allow this email until HEALTH_OWNER_USER_ID is set. Then remove it.
HEALTH_OWNER_EMAIL=

# Read-only connection to the legacy NutriTrack / calorie-tracker Neon database.
# Used only for Nutrition import preview/commit. Never prefix with VITE_.
LEGACY_NUTRITION_DATABASE_URL=

# Server-only bearer token for Health Auto Export REST sync.
# POST /api/ingest/apple-health  Authorization: Bearer <token>
# Generate with: openssl rand -base64 32
# Never prefix with VITE_. This token cannot read Health data or use the owner API.
APPLE_HEALTH_SYNC_TOKEN=

# Server-only bearer token for Shortcut Body capture.
# POST /api/ingest/body  Authorization: Bearer <token>
# Generate with: openssl rand -base64 32
# Never prefix with VITE_. This token cannot read Health data, list the inbox, or save a measurement.
BODY_CAPTURE_TOKEN=

# Calendar timezone for day bucketing, default dates, and period boundaries.
# I0A validates/exposes this configured value. I0B will make it the canonical runtime authority everywhere.
HEALTH_CALENDAR_TIMEZONE=America/Phoenix

# Server-only Gemini nutrition interpretation. Never prefix with VITE_.
# The key must not be sent to the browser. Home-AI remains an explicit fallback.
# A task model overrides GEMINI_NUTRITION_MODEL. The general model is used only when that task model is unset.
GEMINI_API_KEY=
GEMINI_NUTRITION_MODEL=gemini-3.5-flash
GEMINI_NUTRITION_DESCRIPTION_MODEL=gemini-3.5-flash-lite
GEMINI_NUTRITION_MEAL_MODEL=gemini-3.5-flash
GEMINI_NUTRITION_LABEL_MODEL=gemini-3.5-flash
# Recipe text drafts. Falls back to the description model, then GEMINI_NUTRITION_MODEL.
GEMINI_NUTRITION_RECIPE_MODEL=

# Server-only Ask Health model. Falls back to GEMINI_NUTRITION_MODEL when unset.
# Never prefix with VITE_. Reservations count against AI_MONTHLY_BUDGET_USD.
# The warning amount is not a spending gate.
# Nutrition Gemini description, meal-photo, and label attempts share this ledger.
# Home-AI does not. Each blank max-cost falls back to 0.05.
AI_ASK_HEALTH_MODEL=gemini-3.5-flash
AI_MONTHLY_BUDGET_USD=3
AI_WARNING_BUDGET_USD=2
AI_ASK_HEALTH_MAX_REQUEST_COST_USD=0.05
AI_NUTRITION_DESCRIPTION_MAX_REQUEST_COST_USD=
AI_NUTRITION_MEAL_MAX_REQUEST_COST_USD=
AI_NUTRITION_LABEL_MAX_REQUEST_COST_USD=
AI_NUTRITION_RECIPE_ASSIST_MAX_REQUEST_COST_USD=

# Weekly Coach uses the same monthly budget and the same provider rate gate as Ask Health.
# AI_WEEKLY_COACH_MODEL falls back to AI_ASK_HEALTH_MODEL, then GEMINI_NUTRITION_MODEL.
AI_WEEKLY_COACH_MODEL=gemini-3.5-flash
AI_WEEKLY_COACH_MAX_REQUEST_COST_USD=0.05
# AI_EXPERIMENT_SUGGESTION_MODEL falls back to AI_ASK_HEALTH_MODEL, then GEMINI_NUTRITION_MODEL.
AI_EXPERIMENT_SUGGESTION_MODEL=gemini-3.5-flash
AI_EXPERIMENT_SUGGESTION_MAX_REQUEST_COST_USD=0.05
# AI_LITERATURE_MODEL falls back to AI_ASK_HEALTH_MODEL, then GEMINI_NUTRITION_MODEL.
# Literature synthesis shares AI_MONTHLY_BUDGET_USD. The Europe PMC search is not on this ledger.
AI_LITERATURE_MODEL=gemini-3.5-flash
AI_LITERATURE_MAX_REQUEST_COST_USD=0.05

# Server-only USDA FoodData Central key for generic ingredient lookup.
# Never prefix with VITE_. Used only after a food description has no local match.
USDA_FDC_API_KEY=

# Optional Open Food Facts identifying User-Agent. Server-side barcode lookup only.
# OPEN_FOOD_FACTS_USER_AGENT=Health/1.0 (personal nutrition app; owner@example.com)
# OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org


